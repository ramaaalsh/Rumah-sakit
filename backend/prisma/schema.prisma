generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Sesuaikan dengan database yang digunakan (mysql/postgresql)
  url      = env("DATABASE_URL")
}

// ================= ENUM =================
// entitas pegawai hanya dapat di isi dengan nilai di enum
enum RolePegawai {
  ADMIN
  DOKTER
  PERAWAT
}

// entitas tiperawat hanya dapat di isi oleh nilai di bawah ini
enum TipeRawat {
  RAWAT_INAP
  RAWAT_JALAN
}

// ================= MODELS =================

model Pegawai {
  id_pegawai   Int           @id @default(autoincrement())
  nama         String
  role         RolePegawai
  
  // Alamat (Composite)
  jalan        String? // tanda tanya berarti opsional | bisa kosong
  kota         String?
  kode_pos     String?

  // Spesifik Dokter
  spesialisasi String?

  // Spesifik Perawat
  tipe_perawat String?
  unit_bagian  String?

  // Self-Relation (Memimpin)
  pimpinanId   Int?
  pimpinan     Pegawai?      @relation("Memimpin", fields: [pimpinanId], references: [id_pegawai])
  bawahan      Pegawai[]     @relation("Memimpin")

  // Relasi
  no_telp      PegawaiTelp[]
  pendaftaran  Pendaftaran[] // Sebagai Admin
  pemeriksaan  Pemeriksaan[] // Sebagai Dokter
  akun         AkunPegawai?
  jadwal       JadwalDokter[]
}

model PegawaiTelp {
  id         Int     @id @default(autoincrement())
  no_telp    String
  pegawaiId  Int
  pegawai    Pegawai @relation(fields: [pegawaiId], references: [id_pegawai], onDelete: Cascade)
}

model Pasien {
  id_pasien     Int           @id @default(autoincrement())
  nama          String
  jenis_kelamin String
  tanggal_lahir DateTime
  
  // Alamat (Composite)
  jalan         String?
  kota          String?
  kode_pos      String?

  // Relasi
  no_telp       PasienTelp[]
  pendaftaran   Pendaftaran[]
  pembayaran    Pembayaran[]
}

model PasienTelp {
  id         Int     @id @default(autoincrement())
  no_telp    String
  pasienId   Int
  pasien     Pasien  @relation(fields: [pasienId], references: [id_pasien], onDelete: Cascade)
}

model Pendaftaran {
  id_pendaftaran    Int           @id @default(autoincrement())
  tanggal_daftar    DateTime
  keterangan_daftar String?

  pasienId          Int
  pasien            Pasien        @relation(fields: [pasienId], references: [id_pasien])
  adminId           Int
  admin             Pegawai       @relation(fields: [adminId], references: [id_pegawai])

  pemeriksaan       Pemeriksaan[]
}

model Pemeriksaan {
  id_pemeriksaan      Int        @id @default(autoincrement())
  tanggal_pemeriksaan DateTime
  keluhan             String     @db.Text
  diagnosa            String     @db.Text

  pendaftaranId       Int
  pendaftaran         Pendaftaran @relation(fields: [pendaftaranId], references: [id_pendaftaran])
  dokterId            Int
  dokter              Pegawai     @relation(fields: [dokterId], references: [id_pegawai])

  penyakit            Penyakit[]  @relation("PemeriksaanPenyakit")
}

model Penyakit {
  id_penyakit         Int           @id @default(autoincrement())
  nama_penyakit       String
  keterangan_penyakit String?       @db.Text

  pemeriksaan         Pemeriksaan[] @relation("PemeriksaanPenyakit")
  tindakan            Tindakan[]    @relation("PenyakitTindakan")
}

model Tindakan {
  id_tindakan    Int        @id @default(autoincrement())
  nama_tindakan  String
  biaya_tindakan Float

  jenisRawatId   Int
  jenis_rawat    JenisRawat @relation(fields: [jenisRawatId], references: [id_jenis_rawat])

  penyakit       Penyakit[] @relation("PenyakitTindakan")
}

model JenisRawat {
  id_jenis_rawat Int        @id @default(autoincrement())
  tipe_rawat     TipeRawat

  // Spesifik Rawat Inap
  tanggal_masuk  DateTime?
  tanggal_keluar DateTime?
  kamarId        Int?
  kamar          Kamar?     @relation(fields: [kamarId], references: [id_kamar])

  // Spesifik Rawat Jalan
  no_antrian     String?
  status_kontrol String?

  // Relasi
  tindakan       Tindakan[]
  resep          Resep[]
}

model Kamar {
  id_kamar  Int          @id @default(autoincrement())
  no_kamar  String
  kelas     String
  tarif     Float

  rawat_inap JenisRawat[]
}

model Resep {
  id_resep      Int        @id @default(autoincrement())
  tanggal_resep DateTime

  jenisRawatId  Int
  jenis_rawat   JenisRawat @relation(fields: [jenisRawatId], references: [id_jenis_rawat])

  obat          Obat[]     @relation("ResepObat")
}

model Obat {
  id_obat     Int          @id @default(autoincrement())
  nama_obat   String
  harga       Float
  stok        Int

  resep       Resep[]      @relation("ResepObat")
  detail_obat DetailObat[]
}

model DetailObat {
  id_detail    Int        @id @default(autoincrement())
  jumlah       Int
  dosis        String?
  jenis_obat   String?
  harga_satuan Float

  obatId       Int
  obat         Obat       @relation(fields: [obatId], references: [id_obat])

  pembayaranId Int
  pembayaran   Pembayaran @relation(fields: [pembayaranId], references: [id_pembayaran])
}

model Pembayaran {
  id_pembayaran     Int          @id @default(autoincrement())
  tgl_pembayaran    DateTime
  jumlah            Float
  metode_pembayaran String

  pasienId          Int
  pasien            Pasien       @relation(fields: [pasienId], references: [id_pasien])

  detail_obat       DetailObat[]
}

// ================= NEW MODELS =================

model AkunPegawai {
  id         Int     @id @default(autoincrement())
  username   String  @unique
  password   String
  pegawaiId  Int     @unique
  pegawai    Pegawai @relation(fields: [pegawaiId], references: [id_pegawai])
}

model Fasilitas {
  id_fasilitas   Int     @id @default(autoincrement())
  nama_fasilitas String
  deskripsi      String? @db.Text
  icon           String?
}

model JadwalDokter {
  id_jadwal   Int     @id @default(autoincrement())
  hari        String
  jam_mulai   String
  jam_selesai String
  dokterId    Int
  dokter      Pegawai @relation(fields: [dokterId], references: [id_pegawai])
}