{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "lib": ["ES2020", "DOM"],
        "types": ["node"],
        "outDir": "./dist",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true
    },
    "include" : ["src/**/*", "prisma/**/*"], //ngasih tau ts biar yang diproses cuman folder src dan children nya
    "exclude" : ["node_modules", "dist"] //biar folder nya diabaikan/ga diproses
}